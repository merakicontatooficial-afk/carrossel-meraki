# ─────────────────────────────────────────────────────────────
# Backend da plataforma de carrosséis da Meraki
# Copie para `.env` e preencha. NUNCA versionar o .env real.
# ─────────────────────────────────────────────────────────────

# Chave da API do Gemini — CONTA DA MERAKI (não a pessoal do Luiz).
# Criar em https://aistudio.google.com/apikey logado na conta Google da Meraki.
GEMINI_API_KEY=

# Porta do servidor
PORT=8787

# Origem permitida do frontend (dev do Vite = http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Modelos (centralizados; ajustar se o Google renomear) — ver src/gemini.js
GEMINI_MODEL_TEXT=gemini-flash-latest

# Modelos de imagem escolhíveis na plataforma (o usuário troca na hora de gerar).
# O PADRÃO é o Lite: mesma resolução dos outros, 1/4 do preço do Pro, ~8× mais rápido.
GEMINI_MODEL_IMAGE_LITE=gemini-3.1-flash-lite-image
GEMINI_MODEL_IMAGE_FLASH=gemini-3.1-flash-image
GEMINI_MODEL_IMAGE_PRO=gemini-3-pro-image
